---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { assetUrl } from '../utils/assetUrl';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  priority?: boolean;
}
const { src, alt, sizes, priority = false } = Astro.props;
// Uploaded CMS images are discovered at build time, including new filenames.
const images = import.meta.glob<{ default: ImageMetadata }>('/public/images/*.{webp,jpg,jpeg,png}', { eager: true });
const local = images[`/public${src}`]?.default;
---
{local ? (
  <Image src={local} alt={alt} widths={[480, 768, 1024].filter(width => width <= local.width)} sizes={sizes} format="webp" loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
) : (
  <img src={assetUrl(src)} alt={alt} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} decoding="async" />
)}
