---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import contact from '../data/contact.json';
import type { HomeContent } from '../data/content';
import type { Locale } from '../data/locales';
interface Props { home: HomeContent; locale: Locale; }
const { home, locale } = Astro.props;
const { ui } = home;
const email = contact.email.trim();
const phone = contact.phone.trim();
const instagram = contact.instagram.trim();
---
<BaseLayout title={home.seo.title} description={home.seo.description} locale={locale} skipLabel={ui.skip}>
  <div class="preview-bar"><span>{ui.preview}</span><span>{ui.previewNote}</span></div>
  <Header ui={ui} locale={locale} />
  <main id="contenido" tabindex="-1">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="intro">{home.heroIntro}</p>
        <h1 id="hero-title">{home.heroTitle}</h1>
        <p class="hero-attribution">{home.heroAttribution}</p>
        {home.heroDescription.split('\n\n').map(paragraph => <p class="hero-description">{paragraph}</p>)}
        <div class="hero-actions"><a class="button" href="#primeros-pasos">{ui.primaryCta}</a><a class="text-link" href="#metodo">{ui.secondaryCta}</a></div>
        <p class="hero-detail">{ui.heroDetail}</p>
      </div>
      <figure class="hero-photo">
        <ResponsiveImage src={home.heroImage} alt={home.heroImageAlt} sizes="(max-width: 700px) 89vw, 46vw" priority />
        {home.heroCaption && <figcaption>{home.heroCaption}</figcaption>}
        <small class="photo-credit">{home.photoCredit}</small>
      </figure>
      <div class="hero-contact">
        <div><a class="button" href={`mailto:${email}`}>{ui.realContactCta}</a><a class="contact-value" href={`mailto:${email}`}>{email}</a></div>
        <div><a class="text-link" href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{ui.phoneCta}</a><a class="contact-value" href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a></div>
        <div><a class="text-link" href={`https://www.instagram.com/${instagram}/`}>Instagram</a><a class="contact-value" href={`https://www.instagram.com/${instagram}/`}>@{instagram}</a></div>
      </div>
      <div class="hero-foot"><a href="#sesiones">{ui.explore} <span aria-hidden="true">↓</span></a></div>
    </section>

    <section class="sessions section-wrap" id="sesiones" aria-labelledby="sessions-title">
      <div class="sessions-intro">
        <p class="section-label">{ui.sessions}</p><h2 id="sessions-title">{home.sessionsTitle}</h2>
        <p>{home.sessionsDescription}</p>
        <a class="text-link" href="#primeros-pasos">{ui.primaryCta}</a>
      </div>
      <div class="session-details">
        <h3 class="modality-heading">{ui.modalitiesTitle}</h3>
        {home.modalities.map(modality => <article><h3>{modality.title}</h3><p>{modality.text}</p><p class="detail-note">{modality.detail}</p></article>)}
      </div>
      <div class="session-facts"><div><h3>{home.sessionLanguagesTitle}</h3><p>{home.sessionLanguagesDescription}</p></div><div><h3>{home.sessionApproachTitle}</h3><p>{home.sessionApproachDescription}</p></div></div>
    </section>

    <section class="method section-wrap" id="metodo" aria-labelledby="method-title">
      <div class="method-heading">
        <div><p class="section-label">{ui.methodName}</p><h2 id="method-title">{home.methodTitle}</h2></div>
        <div class="method-intro"><p>{home.methodDescription}</p><p>{home.methodSummary}</p></div>
      </div>
      <div class="pillars">{home.pillars.map(pillar => <article><span class="pillar-mark" aria-hidden="true"></span><h3>{pillar.title}</h3><p>{pillar.text}</p></article>)}</div>
      <figure class="practice-image"><ResponsiveImage src={home.practiceImage} alt={home.practiceImageAlt} sizes="(max-width: 700px) 88vw, 84vw" /><figcaption>{home.practiceCaption}</figcaption><small class="photo-credit">{home.photoCredit}</small></figure>
      <div class="method-foot"><p>{home.sessionApproachDescription}</p><a class="text-link" href="#sesiones">{ui.methodCta}</a></div>
    </section>

    <section class="about section-wrap" id="isabel" aria-labelledby="about-title">
      <figure class="about-photo"><ResponsiveImage src={home.portraitImage} alt={home.portraitImageAlt} sizes="(max-width: 700px) 88vw, 38vw" /><figcaption>{home.portraitCaption}</figcaption></figure>
      <div class="about-copy">
        <p class="section-label">{ui.about}</p><h2 id="about-title">{home.aboutTitle}</h2>
        <p>{home.aboutIntroduction}</p><p>{home.aboutBiography}</p>
        <div class="formation"><h3>{ui.formationTitle}</h3><p>{ui.formationDescription}</p><p>{ui.formationNote}</p></div>
        <p class="about-note">{home.aboutNote}</p>
      </div>
    </section>

    <section class="process section-wrap" id="primeros-pasos" aria-labelledby="process-title">
      <div class="process-heading"><div><p class="section-label">{ui.processLabel}</p><h2 id="process-title">{ui.processTitle}</h2></div><p>{ui.processDescription}</p></div>
      <ol class="steps">{home.steps.map((step, index) => <li><span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
      <a class="button" href="#contacto">{ui.contact}</a>
    </section>

    <section class="faq section-wrap" aria-labelledby="faq-title">
      <h2 id="faq-title">{ui.faqTitle}</h2>
      <div class="faq-list">{home.faqs.map(faq => <details><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div>
    </section>

    <section class="contact section-wrap" id="contacto" aria-labelledby="contact-title">
      <div class="contact-copy"><p class="section-label">{ui.contact}</p><h2 id="contact-title">{home.contactTitle}</h2><p>{home.contactDescription}</p><p class="contact-note">{ui.modalityNote}</p></div>
      {email || phone ? <div class="contact-channels">
        <a class="text-link" href={`https://www.instagram.com/${instagram}/`}>Instagram · @{instagram}</a>
        {email && <><a class="button" href={`mailto:${email}`}>{ui.realContactCta}</a><p>{email}</p></>}
        {phone && <><a class="text-link" href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{ui.phoneCta}</a><p>{phone}</p></>}
      </div> : <div class="contact-mock">
        <fieldset disabled aria-describedby="contact-status">
          <legend>{ui.mockLegend}</legend>
          <label for="contact-name">{ui.contactName}</label><input id="contact-name" type="text" autocomplete="name" placeholder={ui.contactName} />
          <label for="contact-email">{ui.contactEmail}</label><input id="contact-email" type="email" autocomplete="email" placeholder={ui.contactEmail} />
          <label for="contact-message">{ui.contactMessage}</label><textarea id="contact-message" rows="3" placeholder={ui.contactPlaceholder}></textarea>
          <button class="button" type="button" disabled>{ui.contactButton}</button>
        </fieldset>
        <p id="contact-status" class="contact-status"><strong>{ui.mockStatus}.</strong> {home.contactPending}</p>
      </div>}
    </section>
  </main>
  <Footer ui={ui} />
</BaseLayout>
