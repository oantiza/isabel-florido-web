---
import { site } from '../data/site';
import { assetUrl } from '../utils/assetUrl';
import '../styles/global.css';
import type { Locale } from '../data/locales';
interface Props { title?: string; description?: string; locale?: Locale; skipLabel?: string; }
const { title = site.name, description = site.description, locale = 'es', skipLabel = 'Saltar al contenido' } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#f7f5ef" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={assetUrl('/favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{skipLabel}</a>
    <slot />
  </body>
</html>
