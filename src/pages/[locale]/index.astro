---
import LandingPage from '../../components/LandingPage.astro';
import { getHomeContent } from '../../data/content';
import { defaultLocale, publishedLocales } from '../../data/locales';
import type { Locale } from '../../data/locales';

export function getStaticPaths() {
  return publishedLocales.filter(locale => locale !== defaultLocale).map(locale => ({ params: { locale } }));
}
const locale = Astro.params.locale as Locale;
---
<LandingPage home={getHomeContent(locale)} locale={locale} />
