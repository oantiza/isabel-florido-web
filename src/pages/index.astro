---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import home from '../data/home.es.json';
const pillars = home.pillars;
---
<BaseLayout title="Isabel Florido | Cuerpo, mente y movimiento consciente">
  <div class="preview-bar">Primera propuesta de portada <span>Diseño y contenidos en revisión</span></div>
  <Header />
  <main id="contenido">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="intro">{home.heroIntro}</p>
        <h1 id="hero-title">{home.heroTitle}</h1>
        <p class="hero-description">{home.heroDescription}</p>
        <a class="button" href="#metodo">Descubre el método <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#isabel">Conoce a Isabel</a>
      </div>
      <figure class="hero-photo">
        <img src={home.heroImage} alt={home.heroImageAlt} width="1024" height="726" fetchpriority="high" />
        <figcaption>{home.heroCaption}</figcaption>
      </figure>
      <div class="hero-foot"><span>{home.heroFootnote}</span><a href="#isabel" aria-label="Continuar a Sobre Isabel">Continúa explorando <span aria-hidden="true">↓</span></a></div>
    </section>
    <section class="about section-wrap" id="isabel" aria-labelledby="about-title">
      <figure class="about-photo"><img src={home.portraitImage} alt={home.portraitImageAlt} width="1024" height="683" loading="lazy" /><figcaption>{home.portraitCaption}</figcaption></figure>
      <div class="about-copy"><p class="section-label">Sobre Isabel</p><h2 id="about-title">{home.aboutTitle}</h2><p>{home.aboutIntroduction}</p><p>{home.aboutBiography}</p><p class="about-note">{home.aboutNote}</p></div>
    </section>
    <section class="method section-wrap" id="metodo" aria-labelledby="method-title">
      <div class="method-heading"><div><p class="section-label">El método</p><h2 id="method-title">{home.methodTitle}</h2></div><div class="method-intro"><p>{home.methodDescription}</p><p>{home.methodSummary}</p></div></div>
      <div class="pillars">{pillars.map(pillar => <article><span class="pillar-mark" aria-hidden="true"></span><h3>{pillar.title}</h3><p>{pillar.text}</p></article>)}</div>
      <div class="practice-image"><img src={home.practiceImage} alt={home.practiceImageAlt} width="1024" height="681" loading="lazy" /><p>{home.practiceCaption}</p></div>
    </section>
    <section class="sessions section-wrap" id="sesiones" aria-labelledby="sessions-title"><div><p class="section-label">Sesiones</p><h2 id="sessions-title">{home.sessionsTitle}</h2><p>{home.sessionsDescription}</p><a class="text-link" href="#contacto">Cómo empezar <span aria-hidden="true">↗</span></a></div><div class="session-details"><article><h3>{home.sessionModalityTitle}</h3><p>{home.sessionModalityDescription}</p></article><article><h3>{home.sessionLanguagesTitle}</h3><p>{home.sessionLanguagesDescription}</p></article><article><h3>{home.sessionApproachTitle}</h3><p>{home.sessionApproachDescription}</p></article></div></section>
    <section class="contact section-wrap" id="contacto" aria-labelledby="contact-title"><p class="section-label">Primer encuentro</p><h2 id="contact-title">{home.contactTitle}</h2><p>{home.contactDescription}</p><div class="contact-pending"><span class="status-dot" aria-hidden="true"></span>{home.contactPending}</div></section>
  </main>
  <Footer />
</BaseLayout>
